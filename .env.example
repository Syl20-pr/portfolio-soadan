# =============================================================================
#  Copiez ce fichier en « .env » puis renseignez vos vraies valeurs.
#  Le fichier .env ne doit JAMAIS être versionné ni exposé publiquement.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votre-domaine.tld

# --- Base de données MySQL / MariaDB ---------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_sks
DB_USER=portfolio_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- SMTP (PHPMailer) -------------------------------------------------------
SMTP_HOST=smtp.votre-hebergeur.tld
SMTP_PORT=587
SMTP_USERNAME=adresse@votre-domaine.tld
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# --- Adresses email ---------------------------------------------------------
# MAIL_FROM doit, dans la plupart des hébergeurs, appartenir au domaine.
MAIL_FROM=adresse@votre-domaine.tld
MAIL_FROM_NAME=Portfolio SOADAN Koffi Sylvain
MAIL_TO=sylvainsoadan3@gmail.com

# --- Administrateur ---------------------------------------------------------
# Renseignez ici le mot de passe en clair (il sera haché une seule fois via
# tools/hash_password.php). Une fois le hash généré et collé dans .env,
# laissez ce champ vide puis supprimez la ligne.
ADMIN_EMAIL=sylvainsoadan3@gmail.com
ADMIN_PASSWORD=
# Hash bcrypt généré par password_hash() — à coller ici.
ADMIN_PASSWORD_HASH=

# --- Sécurité ---------------------------------------------------------------
# Chaîne aléatoire longue (>= 32 caractères) servant de clé applicative.
APP_KEY=
# Durée de validité d'un jeton CSRF / session (secondes).
SESSION_LIFETIME=3600
# Délai minimal (secondes) entre l'affichage du formulaire et sa soumission.
CONTACT_MIN_DELAY=3
# Nombre maximum de soumissions autorisées par heure et par adresse IP.
CONTACT_MAX_PER_HOUR=5
