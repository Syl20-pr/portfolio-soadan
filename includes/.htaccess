# =============================================================================
#  Protection du dossier includes/ — accès direct interdit
#  Ces fichiers ne doivent être inclus que par du code PHP côté serveur.
# =============================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
